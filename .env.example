# Mappe — registrazione gratis su maptiler.com (100k req/mese free)
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here
SKELETON_INDEX_BATCH_SIZE=200

# Google AdSense — lasciare vuoto finché non approvato
NEXT_PUBLIC_ADSENSE_CLIENT=

# Analytics privacy-friendly
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=sentierivda.it

# Newsletter (resend.com)
RESEND_API_KEY=
NEWSLETTER_FROM=newsletter@sentierivda.it
# ID della "Audience" su Resend a cui aggiungere gli iscritti (dashboard → Audiences)
RESEND_AUDIENCE_ID=

# Affiliazioni
NEXT_PUBLIC_BOOKING_AFF_ID=
NEXT_PUBLIC_GETYOURGUIDE_PID=
